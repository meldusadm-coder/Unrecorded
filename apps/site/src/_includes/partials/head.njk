<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
<link rel="canonical" href="{{ site.host }}{{ canonicalPath }}" />
<meta name="theme-color" content="{{ site.themeColor }}" />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
<meta property="og:type" content="{{ ogType | default('website') }}" />
<meta property="og:url" content="{{ site.host }}{{ canonicalPath }}" />
<meta property="og:title" content="{{ title }}" />
<meta property="og:description" content="{{ description }}" />
<meta property="og:image" content="{{ site.host }}{{ site.socialCard }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ title }}" />
<meta name="twitter:description" content="{{ description }}" />
<meta name="twitter:image" content="{{ site.host }}{{ site.socialCard }}" />
{% if schema == "home" %}
  {% include "partials/schema-home.njk" %}
{% endif %}
<link rel="stylesheet" href="/assets/styles.css" />
