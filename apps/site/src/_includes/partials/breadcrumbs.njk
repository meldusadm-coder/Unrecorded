{% if breadcrumbLabel %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ site.host }}/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ breadcrumbLabel }}",
      "item": "{{ site.host }}{{ canonicalPath }}"
    }
  ]
}
</script>
{% endif %}
